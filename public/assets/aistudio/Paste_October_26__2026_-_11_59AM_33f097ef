/* ---------- firebase error helper ---------- */
function fbErrMsg(err,fallback){
  const c=(err&&err.code)||'';
  if(c==='permission-denied')return 'ডাটাবেস অনুমতি দিচ্ছে না (Firestore Rules সমস্যা)। ইন্টারনেটে সমস্যা নেই — Firebase Console > Firestore > Rules এ read/write অনুমতি দিন।';
  if(c==='unavailable'||c==='deadline-exceeded'||(navigator.onLine===false))return 'ইন্টারনেট সংযোগ নেই বা সার্ভার পাওয়া যাচ্ছে না। ইন্টারনেট চেক করে আবার চেষ্টা করুন।';
  if(c==='resource-exhausted')return 'Firebase এর ফ্রি কোটা শেষ হয়ে গেছে। কিছুক্ষণ পর চেষ্টা করুন।';
  if(c==='invalid-argument'||c==='out-of-range')return 'ডাটা সঠিক নয় (খুব বড় বা অবৈধ মান)। তথ্য ও ছবি চেক করুন।';
  return fallback+(err&&err.message?' ('+err.message+')':'');
}

/* ================= CLOUDINARY VIDEO UPLOAD (+ auto compress if >100MB) ================= */
const MAX_VIDEO_BYTES = 100 * 1024 * 1024;
const TARGET_VIDEO_BYTES = 90 * 1024 * 1024;

function setVidStatus(text, pct) {
  const box = document.getElementById('videoUploadStatus');
  if (!box) return;
  if (text === null) { box.classList.add('hidden'); return; }
  box.classList.remove('hidden');
  document.getElementById('videoUploadText').textContent = text;
  document.getElementById('videoUploadBar').style.width = (pct || 0) + '%';
}

function loadVideoMeta(file) {
  return new Promise((res, rej) => {
    const v = document.createElement('video');
    v.preload = 'metadata';
    v.onloadedmetadata = () => { const d = v.duration; URL.revokeObjectURL(v.src); res(d); };
    v.onerror = () => rej(new Error('ভিডিও ফাইলটি পড়া যাচ্ছে না'));
    v.src = URL.createObjectURL(file);
  });
}

async function compressVideo(file) {
  if (!window.MediaRecorder) throw new Error('এই ব্রাউজারে ভিডিও কমপ্রেস সাপোর্ট নেই (Chrome ব্যবহার করুন)');
  const duration = await loadVideoMeta(file);
  if (!isFinite(duration) || duration <= 0) throw new Error('ভিডিওর সময়কাল জানা যায়নি');
  const audioBps = 96000;
  const videoBps = Math.floor((TARGET_VIDEO_BYTES * 8) / duration - audioBps);
  if (videoBps < 250000) throw new Error('ভিডিওটি অনেক লম্বা, ১০০ MB-এর মধ্যে আনা সম্ভব নয়');

  const v = document.createElement('video');
  v.src = URL.createObjectURL(file);
  v.playsInline = true;
  v.preload = 'auto';
  await new Promise((res, rej) => { v.onloadeddata = res; v.onerror = () => rej(new Error('ভিডিও লোড হয়নি')); });

  const capture = v.captureStream || v.mozCaptureStream;
  if (!capture) throw new Error('এই ব্রাউজারে ভিডিও কমপ্রেস সাপোর্ট নেই (Chrome ব্যবহার করুন)');
  const stream = capture.call(v);

  // অডিও ট্র্যাক (রেকর্ডের সময় শব্দ বাজবে না)
  try {
    const AC = window.AudioContext || window.webkitAudioContext;
    const actx = new AC();
    const src = actx.createMediaElementSource(v);
    const dest = actx.createMediaStreamDestination();
    src.connect(dest);
    stream.getAudioTracks().forEach(t => stream.removeTrack(t));
    dest.stream.getAudioTracks().forEach(t => stream.addTrack(t));
  } catch (_) {}

  const types = ['video/webm;codecs=vp9,opus', 'video/webm;codecs=vp8,opus', 'video/webm', 'video/mp4'];
  const mime = types.find(t => MediaRecorder.isTypeSupported(t)) || '';
  const rec = new MediaRecorder(stream, mime ? { mimeType: mime, videoBitsPerSecond: videoBps, audioBitsPerSecond: audioBps } : { videoBitsPerSecond: videoBps });
  const chunks = [];
  rec.ondataavailable = e => { if (e.data.size) chunks.push(e.data); };
  const done = new Promise((res, rej) => {
    rec.onstop = () => res(new Blob(chunks, { type: rec.mimeType || 'video/webm' }));
    rec.onerror = () => rej(new Error('কমপ্রেস ব্যর্থ হয়েছে'));
  });

  const timer = setInterval(() => {
    const p = Math.min(99, Math.round((v.currentTime / duration) * 100));
    setVidStatus('ভিডিও কমপ্রেস হচ্ছে... ' + p + '% (ট্যাব খোলা রাখুন)', p);
  }, 500);

  try {
    rec.start(1000);
    await v.play();
    await new Promise(r => { v.onended = r; });
  } finally { clearInterval(timer); }
  if (rec.state !== 'inactive') rec.stop();
  const blob = await done;
  URL.revokeObjectURL(v.src);
  if (blob.size > MAX_VIDEO_BYTES) throw new Error('কমপ্রেসের পরেও ফাইল ১০০ MB-এর বেশি');
  const ext = blob.type.includes('mp4') ? 'mp4' : 'webm';
  return new File([blob], 'compressed.' + ext, { type: blob.type });
}

function uploadVideoToCloudinary(file) {
  return new Promise((resolve, reject) => {
    if (!CLOUDINARY_CLOUD_NAME || CLOUDINARY_CLOUD_NAME.startsWith('YOUR_')) return reject(new Error('Cloudinary Cloud Name সেট করা হয়নি'));
    const fd = new FormData();
    fd.append('file', file);
    fd.append('upload_preset', CLOUDINARY_UPLOAD_PRESET);
    const xhr = new XMLHttpRequest();
    xhr.open('POST', `https://api.cloudinary.com/v1_1/${CLOUDINARY_CLOUD_NAME}/video/upload`);
    xhr.upload.onprogress = e => {
      if (e.lengthComputable) {
        const p = Math.round((e.loaded / e.total) * 100);
        setVidStatus('ভিডিও আপলোড হচ্ছে... ' + p + '%', p);
      }
    };
    xhr.onload = () => {
      try {
        const data = JSON.parse(xhr.responseText);
        if (xhr.status >= 200 && xhr.status < 300 && data.secure_url) {
          // f_auto,q_auto: প্রতিটি ডিভাইসের উপযোগী ফরম্যাট ও অপ্টিমাইজড কোয়ালিটি
          resolve(data.secure_url.replace('/upload/', '/upload/f_auto,q_auto/'));
        } else reject(new Error((data.error && data.error.message) || 'ভিডিও আপলোড ব্যর্থ'));
      } catch (e) { reject(new Error('আপলোড রেসপন্স পড়া যায়নি')); }
    };
    xhr.onerror = () => reject(new Error('ইন্টারনেট সংযোগ সমস্যা'));
    xhr.send(fd);
  });
}

async function processAndUploadVideo(file) {
  if (!file.type.startsWith('video/')) throw new Error('শুধু ভিডিও ফাইল দিন');
  let f = file;
  if (file.size > MAX_VIDEO_BYTES) {
    setVidStatus('ভিডিও বড় (' + (file.size / 1048576).toFixed(0) + ' MB), কমপ্রেস শুরু হচ্ছে...', 0);
    f = await compressVideo(file);
  }
  setVidStatus('ভিডিও আপলোড হচ্ছে... 0%', 0);
  const url = await uploadVideoToCloudinary(f);
  setVidStatus(null);
  return url;
}

