<script>
(function(){
const $=id=>document.getElementById(id);
let usersLoaded=!isFirebaseReady;

/* ---------- A. প্রথম অ্যাডমিন বানানোর ফর্ম (অ্যাডমিন না থাকলেই দেখাবে) ---------- */
const lf=document.querySelector('#adminLoginModal form');
lf.id='adminLoginForm';
const INP='w-full p-2 text-xs rounded-lg border border-slate-200 outline-none';
lf.insertAdjacentHTML('beforebegin',`
<div id="adminSetupBox" class="hidden p-4 sm:p-6 space-y-3 text-sm">
  <div class="bg-rose-50 text-rose-800 text-[11px] p-2 rounded-lg border border-rose-200">কোনো অ্যাডমিন নেই। নিজের তথ্য দিয়ে প্রথম অ্যাডমিন তৈরি করুন।</div>
  <input type="text" id="setupName" placeholder="নাম" class="${INP}">
  <input type="tel" id="setupPhone" placeholder="মোবাইল 01XXXXXXXXX" class="${INP}">
  <input type="email" id="setupEmail" placeholder="ইমেইল" class="${INP}">
  <input type="password" id="setupPass" placeholder="শক্ত পাসওয়ার্ড (কমপক্ষে ৬ অক্ষর)" autocomplete="new-password" class="${INP}">
  <button type="button" onclick="handleAdminSetup()" class="w-full py-2.5 bg-slate-900 hover:bg-black text-white rounded-lg font-bold text-xs">অ্যাডমিন তৈরি করুন</button>
</div>`);
function updateSetupUI(){
  const need=usersLoaded&&!users.some(u=>u.role==='admin');
  $('adminSetupBox').classList.toggle('hidden',!need);
  lf.classList.toggle('hidden',need);
}
const _tal=toggleAdminLoginModal;
toggleAdminLoginModal=function(s){_tal(s);if(s)updateSetupUI();};

window.handleAdminSetup=async function(){
  if(!usersLoaded||users.some(u=>u.role==='admin'))return alert('অ্যাডমিন আগেই আছে।');
  const g=id=>$(id).value.trim();
  const name=cleanName(g('setupName')),phone=normPhone(g('setupPhone')),email=g('setupEmail').toLowerCase(),password=g('setupPass');
  if(!name)return alert('নাম লিখুন!');
  if(!validPhone(phone))return alert('সঠিক ১১ ডিজিটের মোবাইল নম্বর দিন!');
  if(!/^\S+@\S+\.\S+$/.test(email))return alert('সঠিক ইমেইল দিন!');
  if(password.length<6||password.toLowerCase()==='admin')return alert('কমপক্ষে ৬ অক্ষরের শক্ত পাসওয়ার্ড দিন!');
  if(users.some(u=>u.phone===phone))return alert('এই মোবাইল নম্বর আগেই ব্যবহৃত!');
  const nu={name,phone,email,password,role:'admin'};
  try{
    if(isFirebaseReady)await firebaseDb.collection('users').doc('user_'+phone).set(nu);
    else{users.push(nu);localStorage.setItem('tolet_users',JSON.stringify(users));}
    currentUser=nu;localStorage.setItem('tolet_current_user',JSON.stringify(nu));
    toggleAdminLoginModal(false);updateAuthUI();openAdminModal();
