    function playVideo(videoSrc) {
      const container = document.getElementById('videoContainer');
      container.innerHTML = '';
      if (!videoSrc) return;
      const trimmed = videoSrc.trim();

      const ytMatch = trimmed.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|shorts\/))([\w-]{11})/);
      if (ytMatch) {
        container.innerHTML = `<iframe class="w-full h-full aspect-video" src="https://www.youtube.com/embed/${ytMatch[1]}?autoplay=1" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>`;
        return showVideoModal();
      }
      if (trimmed.includes("drive.google.com")) {
        const fileId = trimmed.match(/\/d\/([a-zA-Z0-9_-]+)/);
        if (fileId) {
          container.innerHTML = `<iframe class="w-full h-full aspect-video" src="https://drive.google.com/file/d/${fileId[1]}/preview" allow="autoplay"></iframe>`;
          return showVideoModal();
        }
      }
      if (trimmed.includes("facebook.com") || trimmed.includes("fb.watch")) {
        container.innerHTML = `<iframe src="https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(trimmed)}&show_text=0&width=560" class="w-full h-full aspect-video" frameborder="0" allowfullscreen="true" allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"></iframe>`;
        return showVideoModal();
      }
      container.innerHTML = `
        <video controls autoplay playsinline disablePictureInPicture controlsList="nodownload noplaybackrate" oncontextmenu="return false;" class="w-full h-full max-h-[75vh] object-contain">
          <source src="${trimmed}">
          আপনার ব্রাউজার ভিডিও সাপোর্ট করছে না।
        </video>`;
      showVideoModal();
    }

