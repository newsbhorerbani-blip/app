async function importUsersRows(rows){
  const K={name:['name','নাম','ব্যবহারকারীর নাম'],phone:['phone','mobile','মোবাইল','মোবাইল নম্বর','ফোন'],email:['email','ইমেইল','ইমেইল ঠিকানা'],password:['password','পাসওয়ার্ড'],role:['role','ভূমিকা']};
  let skipped=0;const errs=[],list=[],seen=new Set();
  rows.forEach((r,i)=>{
    const name=cleanName(_pick(r,K.name)),phone=normPhone(_pick(r,K.phone)),email=_pick(r,K.email).toLowerCase(),password=_pick(r,K.password),roleRaw=_pick(r,K.role).toLowerCase();
    if(!name&&!phone&&!email&&!password)return;
    const line=i+2;
    if(!name||!validPhone(phone)||password.length<4){skipped++;errs.push('লাইন '+line+': নাম, সঠিক মোবাইল ও কমপক্ষে ৪ অক্ষরের পাসওয়ার্ড দরকার');return;}
    if(seen.has(phone)){skipped++;errs.push('লাইন '+line+': মোবাইল নম্বর ফাইলে দুইবার আছে');return;}
    if(email&&(users.some(u=>u.phone!==phone&&u.email&&u.email.toLowerCase()===email)||list.some(x=>x.u.phone!==phone&&x.u.email&&x.u.email===email))){skipped++;errs.push('লাইন '+line+': ইমেইল অন্য অ্যাকাউন্টে ব্যবহৃত');return;}
    seen.add(phone);
    const ex=users.find(u=>u.phone===phone);
    list.push({isNew:!ex,u:{name,phone,email,password,role:ex?(ex.role||'user'):(roleRaw==='admin'?'admin':'user')}});
  });
  if(!list.length)return 'ব্যবহারকারী: কোনো সঠিক সারি পাওয়া যায়নি।'+_errTail(errs);
  if(isFirebaseReady){
    for(let i=0;i<list.length;i+=400){
      const b=firebaseDb.batch();
      list.slice(i,i+400).forEach(x=>b.set(firebaseDb.collection('users').doc('user_'+x.u.phone),x.u));
      await b.commit();
    }
  }else{
    list.forEach(x=>{const ix=users.findIndex(u=>u.phone===x.u.phone);if(ix>=0)users[ix]=x.u;else users.push(x.u);});
    localStorage.setItem('tolet_users',JSON.stringify(users));renderAdminUsersTable();
  }
  const added=list.filter(x=>x.isNew).length;
  return 'ব্যবহারকারী: '+added+'জন নতুন যুক্ত, '+(list.length-added)+'জন আপডেট, '+skipped+'টি বাদ।'+_errTail(errs);
}

async function importLocationsRows(rows){
  const names=[];
  rows.forEach(r=>{const v=_pick(r,['area','এলাকা','এলাকার নাম','name']);if(v&&!names.includes(v))names.push(v);});
  if(!names.length)return 'এলাকা: কোনো এলাকার নাম পাওয়া যায়নি (কলামের নাম: Area)।';
  const replace=confirm('এলাকা তালিকা: ফাইলে '+names.length+'টি এলাকা আছে।\n\nOK = বর্তমান তালিকা সম্পূর্ণ বদলে ফাইলের তালিকা বসাও\nCancel = শুধু নতুন এলাকাগুলো যুক্ত করো');
  if(replace)locations=names;
  else{let n=0;names.forEach(x=>{if(!locations.includes(x)){locations.push(x);n++;}});if(!n)return 'এলাকা: নতুন কোনো এলাকা নেই, সব আগেই আছে।';}
  afterLocChange();
  return 'এলাকা: '+(replace?'তালিকা প্রতিস্থাপন হয়েছে':'নতুন এলাকা যুক্ত হয়েছে')+' (এখন মোট '+locations.length+'টি)।';
}

async function importSettingsRows(rows){
  const patch={};
  rows.forEach(r=>{
    const k=_pick(r,['key','কী']);const v=_pick(r,['value','মান']);
    if(!(k in _SETTING_LABELS))return;
    if(k==='footerFb'){patch[k]=v?(safeUrl(v)||adSettings.footerFb):'https://facebook.com';}
    else patch[k]=v;
  });
  if(!Object.keys(patch).length)return 'ফুটার: কোনো সঠিক সেটিং পাওয়া যায়নি (কলাম: Key, Value)।';
  await persistAdSettings(patch);
  return 'ফুটার যোগাযোগ তথ্য আপডেট হয়েছে।';
}

async function excelUpload(kind,input){
  const f=input.files&&input.files[0];input.value='';
