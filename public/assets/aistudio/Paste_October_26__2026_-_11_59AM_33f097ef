/* chips (single / multi) */
function chips(boxId,opts,sel,multi,cb){
  const box=$(boxId);box.innerHTML='';
  opts.forEach(o=>{
    const b=document.createElement('button');b.type='button';
    const on=sel.includes(o);
    b.className='um-chip'+(on?' on':'');b.textContent=(on?'✓ ':'')+o;
    b.onclick=()=>{
      const i=sel.indexOf(o);
      if(multi){i>=0?sel.splice(i,1):sel.push(o);}else{sel.length=0;sel.push(o);}
      chips(boxId,opts,sel,multi,cb);if(cb)cb();
    };
    box.appendChild(b);
  });
}
/* quick-fill chips */
function quick(boxId,vals,inp,fmt,before){
  const b=$(boxId);b.innerHTML='';
  vals.forEach(v=>{
    const x=document.createElement('button');x.type='button';x.className='um-chip q';x.textContent=fmt?fmt(v):v;
    x.onclick=()=>{if(before)before();inp.value=v;inp.focus();};b.appendChild(x);
  });
}

/* ================= DATA ================= */
let mk=[],rq=[],fromAdm=false;
const get=k=>k==='mk'?mk:rq;
const setArr=(k,a)=>{if(k==='mk')mk=a;else rq=a;};
const lsSave=k=>localStorage.setItem(LSK[k],JSON.stringify(get(k)));
async function dbSet(k,o){
  if(isFirebaseReady)await firebaseDb.collection(COL[k]).doc(String(o.id)).set(o);
  else{const a=get(k).filter(x=>x.id!=o.id);a.push(o);setArr(k,a);lsSave(k);refresh();}
}
async function dbPatch(k,id,p){
  if(isFirebaseReady)await firebaseDb.collection(COL[k]).doc(String(id)).update(p);
  else{Object.assign(get(k).find(x=>x.id==id)||{},p);lsSave(k);refresh();}
}
async function dbDel(k,id){
  if(isFirebaseReady)await firebaseDb.collection(COL[k]).doc(String(id)).delete();
  else{setArr(k,get(k).filter(x=>x.id!=id));lsSave(k);refresh();}
}

/* ================= 7 DIN PORE AUTO DELETE ================= */
const expLs=x=>!!(x&&x.rented&&x.rentedAt&&Date.now()-x.rentedAt>=WEEK);
const expMk=x=>!!(x&&x.status==='sold'&&x.soldAt&&Date.now()-x.soldAt>=WEEK);
const expRq=x=>!!(x&&x.status==='done'&&x.doneAt&&Date.now()-x.doneAt>=WEEK);
let _ct=null;
function schedule(){clearTimeout(_ct);_ct=setTimeout(cleanup,2500);}
async function cleanup(){
  const jobs=[['listings',listings.filter(expLs)],[COL.mk,mk.filter(expMk)],[COL.rq,rq.filter(expRq)]];
  if(!jobs.some(j=>j[1].length))return;
  try{
    if(isFirebaseReady){
      const refs=[];
      jobs.forEach(([c,a])=>a.forEach(x=>refs.push(firebaseDb.collection(c).doc(String(x.id)))));
      for(let i=0;i<refs.length;i+=400){const b=firebaseDb.batch();refs.slice(i,i+400).forEach(r=>b.delete(r));await b.commit();}
    }else{
      listings=listings.filter(x=>!expLs(x));localStorage.setItem('gopalganj_tolet',JSON.stringify(listings));
      mk=mk.filter(x=>!expMk(x));lsSave('mk');
      rq=rq.filter(x=>!expRq(x));lsSave('rq');
      applyFilters();refresh();
    }
  }catch(e){console.warn('Auto-delete notice:',e);}
}
setInterval(cleanup,3600000);
const _af=applyFilters;
applyFilters=function(){_af();schedule();};

/* ================= BASA: "ভাড়া হয়ে গেছে" MARK ================= */
async function toggleRented(id){
  const it=listings.find(l=>l.id==id);
  if(!it||!canManage(it))return alert('আপনার অনুমতি নেই!');
  const on=!it.rented;
  if(on&&!confirm('বাসাটি "ভাড়া হয়ে গেছে" হিসেবে মার্ক করবেন?\nমার্ক করার ৭ দিন পরে বিজ্ঞাপনটি নিজে থেকেই মুছে যাবে।'))return;
  const patch=on?{rented:true,rentedAt:Date.now()}:{rented:false,rentedAt:0};
  try{
    if(isFirebaseReady)await firebaseDb.collection('listings').doc(String(id)).update(patch);
    else{Object.assign(it,patch);localStorage.setItem('gopalganj_tolet',JSON.stringify(listings));applyFilters();renderAdminAdsList();renderUserAdsList();}
  }catch(e){console.error(e);alert(fbErrMsg(e,'আপডেট করা যায়নি।'));}
}
const _bar=buildAdRows;
buildAdRows=function(c,items,closeFn){
  _bar(c,items,closeFn);
  [...c.children].forEach((row,i)=>{
    const it=items[i];if(!it||!canManage(it))return;
    const box=row.lastElementChild;
    const b=document.createElement('button');
    b.className='px-2 py-1 text-[11px] font-bold rounded-lg '+(it.rented?'bg-slate-100 hover:bg-slate-200 text-slate-700':'bg-amber-50 hover:bg-amber-100 text-amber-700');
    b.textContent=it.rented?'আবার খালি':'ভাড়া হয়েছে';
    b.onclick=()=>toggleRented(it.id);
    box.prepend(b);
    if(it.rented){
      const h=row.querySelector('h4');
      if(h)h.insertAdjacentHTML('beforeend',' <span class="text-[9px] bg-rose-100 text-rose-700 px-1.5 py-0.5 rounded font-bold">ভাড়া হয়ে গেছে'+(it.rentedAt?' • '+bn(daysLeft(it.rentedAt))+' দিন বাকি':'')+'</span>');
    }
  });
};
const _rl=renderListings;
renderListings=function(items){
  const vis=items.filter(x=>!expLs(x)).sort((a,b)=>(!!a.rented)-(!!b.rented));
  _rl(vis);
  const kids=$('listingsContainer').children;
  vis.forEach((it,i)=>{
    if(!it.rented)return;
    const card=kids[i];if(!card)return;
    card.classList.add('opacity-75');
    const top=card.querySelector('.relative');
    if(top)top.insertAdjacentHTML('beforeend','<div class="absolute inset-x-0 bottom-0 bg-rose-600/90 text-white text-center text-xs font-bold py-1.5 z-10 pointer-events-none">ভাড়া হয়ে গেছে'+(it.rentedAt?' • '+bn(daysLeft(it.rentedAt))+' দিন পরে মুছে যাবে':'')+'</div>');
  });
};
const _hf=handleFormSubmit;
handleFormSubmit=function(e){
  const eid=$('editListingId').value,old=eid?listings.find(l=>l.id==eid):null;
  const keep=old&&old.rented?{rented:true,rentedAt:old.rentedAt||Date.now()}:null;
  const p=_hf(e);
  if(!keep)return p;
  return Promise.resolve(p).then(async()=>{
    try{
      if(isFirebaseReady)await firebaseDb.collection('listings').doc(String(eid)).update(keep);
      else{const n=listings.find(l=>l.id==eid);if(n){Object.assign(n,keep);localStorage.setItem('gopalganj_tolet',JSON.stringify(listings));applyFilters();}}
    }catch(_){}
  });
};

