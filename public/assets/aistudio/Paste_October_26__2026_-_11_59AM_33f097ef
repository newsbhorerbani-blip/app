/* forgot password: OTP never shown on screen, expires, limited tries, secure random */
let _otpExpiry=0,_otpTries=0;
function emailErrHint(status,text){
  const t=String(text||'');
  if(status===undefined)return 'ইন্টারনেট সংযোগ বা ব্রাউজারের ব্লকার (AdBlock) সমস্যা হতে পারে।';
  if(/recipients address is empty/i.test(t))return 'EmailJS টেমপ্লেটের "To Email" ঘরে {{to_email}} লিখুন।';
  if(status===412||/gmail|authentication|insufficient/i.test(t))return 'EmailJS Dashboard > Email Services এ Gmail সার্ভিসটি আবার Reconnect করুন।';
  if(status===401||status===403||/public key|origin|domain/i.test(t))return 'EmailJS এর Public Key সঠিক কিনা এবং Account > Security এ আপনার সাইটের ডোমেইন অনুমোদিত কিনা দেখুন।';
  if(status===400)return 'Service ID / Template ID ভুল অথবা টেমপ্লেটের ভেরিয়েবল মিলছে না।';
  if(status===404)return 'Service ID অথবা Template ID পাওয়া যায়নি।';
  if(status===429)return 'EmailJS এর ফ্রি লিমিট (মাসে ২০০টি) শেষ হয়ে গেছে।';
  return '';
}
async function sendOtpViaEmail(){
  const email=document.getElementById('fpEmail').value.trim().toLowerCase();
  if(!email)return alert('দয়া করে আপনার নিবন্ধিত ইমেইল ঠিকানা লিখুন!');
  if(!users.length)return alert('ব্যবহারকারীর তালিকা লোড হয়নি। ইন্টারনেট চেক করে পেজ রিফ্রেশ করুন।');
  const user=users.find(u=>u.email&&u.email.toLowerCase()===email);
  if(!user)return alert('এই ইমেইল দিয়ে কোনো অ্যাকাউন্ট পাওয়া যায়নি!');
  const a=new Uint32Array(1);crypto.getRandomValues(a);
  const otp=String(100000+a[0]%900000);
  const btn=document.getElementById('btnSendOtp');
  const reset=()=>{btn.disabled=false;btn.innerHTML='<i class="fa-solid fa-paper-plane text-xs"></i> ইমেইলে OTP পাঠান';};
  btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> ওটিপি পাঠানো হচ্ছে...';
  const nm=user.name||'ব্যবহারকারী';
  const msg='আপনার টু-লেট গোপালগঞ্জ অ্যাকাউন্টের পাসওয়ার্ড পুনরুদ্ধারের ৬ সংখ্যার ওটিপি কোড হলো: '+otp+' (৫ মিনিট পর্যন্ত বৈধ)';
  const params={to_email:email,email:email,user_email:email,to:email,reply_to:email,recipient:email,to_name:nm,name:nm,user_name:nm,message:msg,app_name:'টু-লেট গোপালগঞ্জ',valid_minutes:'5',expiry:'5 minutes',time:'5'};
  ['otp_code','otp','OTP','Otp','code','Code','passcode','otp_number','otp_value','user_otp','verification_code','verify_code','reset_code','reset_otp','one_time_password','password_reset_otp','pin','token','otpCode','OTP_CODE','generated_otp'].forEach(k=>{params[k]=otp;});
  try{
    const res=await fetch('https://api.emailjs.com/api/v1.0/email/send',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({service_id:EMAILJS_SERVICE_ID,template_id:EMAILJS_TEMPLATE_ID,user_id:EMAILJS_PUBLIC_KEY,template_params:params})});
    const txt=await res.text();
    if(!res.ok)throw {status:res.status,text:txt};
    generatedOtp=otp;otpTargetEmail=email;_otpExpiry=Date.now()+5*60000;_otpTries=0;
    handleOtpSentSuccess();
  }catch(err){
    console.error('EmailJS error:',err);reset();
    const st=err&&err.status,tx=(err&&err.text)||(err&&err.message)||'';
    alert('OTP পাঠানো যায়নি।\nকারণ: '+(st?st+' - ':'')+tx+'\n\n'+emailErrHint(st,tx));
  }
}
async function verifyOtpAndResetPassword(){
  const otp=document.getElementById('fpInputOtp').value.trim(),np=document.getElementById('fpNewPassword').value.trim();
  if(!generatedOtp||Date.now()>_otpExpiry)return alert('OTP-র মেয়াদ শেষ! আবার OTP পাঠান।');
  if(++_otpTries>5){generatedOtp=null;return alert('অনেকবার ভুল করেছেন! আবার OTP পাঠান।');}
  if(otp!==generatedOtp)return alert('ভুল OTP কোড! সঠিক কোড দিন।');
  if(np.length<4)return alert('কমপক্ষে ৪ অক্ষরের নতুন পাসওয়ার্ড দিন!');
  const t=users.find(u=>u.email&&u.email.toLowerCase()===otpTargetEmail);
  if(!t)return alert('ব্যবহারকারী খুঁজে পাওয়া যায়নি!');
  const u=Object.assign({},t,{password:np});
  try{
    if(isFirebaseReady)await saveUserDoc(u);
    else{users=users.map(x=>x.phone===u.phone?u:x);localStorage.setItem('tolet_users',JSON.stringify(users));}
  }catch(err){console.error(err);return alert('পাসওয়ার্ড পরিবর্তন ব্যর্থ হয়েছে।');}
  generatedOtp=null;
  alert('পাসওয়ার্ড সফলভাবে পরিবর্তন করা হয়েছে! এখন লগইন করুন।');
