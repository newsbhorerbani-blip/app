function _readXlsx(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>{try{res(XLSX.read(r.result,{type:'array'}));}catch(e){rej(e);}};r.onerror=()=>rej(r.error);r.readAsArrayBuffer(file);});}
function _sheetRows(wb,names,fallbackFirst){
