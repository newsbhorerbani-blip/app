<!-- ===== SMART SEARCH: বাংলা / English / Banglish / উচ্চারণ মিল ===== -->
<script>
(function(){
const $=id=>document.getElementById(id);
const PH='বাংলা / English / Banglish লিখুন...';

/* ---------- ধ্বনি-চাবি: বাংলা ও রোমান লেখাকে একই "উচ্চারণ কাঠামোতে" আনে ---------- */
const BN={'ক':'k','খ':'k','গ':'g','ঘ':'g','ঙ':'ng','চ':'C','ছ':'C','জ':'j','ঝ':'j','ঞ':'n','ট':'t','ঠ':'t','ড':'d','ঢ':'d','ণ':'n','ত':'t','থ':'t','দ':'d','ধ':'d','ন':'n','প':'p','ফ':'p','ব':'b','ভ':'b','ম':'m','য':'j','র':'r','ল':'l','শ':'s','ষ':'s','স':'s','ৎ':'t','ং':'ng'};
function key(s){
  s=String(s==null?'':s).normalize('NFC').toLowerCase();
  s=s.replace(/[০-৯]/g,d=>String(d.charCodeAt(0)-0x09E6));
  s=s.replace(/[ডঢ]\u09BC/g,'র').replace(/য\u09BC/g,'').replace(/\u09CD\u09AF/g,'');
  s=s.replace(/ch/g,'C').replace(/x/g,'ks').replace(/[qc]/g,'k').replace(/f/g,'p').replace(/v/g,'b').replace(/z/g,'j');
  s=s.replace(/[\u0980-\u09FF]/g,c=>BN[c]||'');
  s=s.replace(/[aeiouyhw]/g,'').replace(/[^a-zA-Z0-9]/g,'');
  return s.replace(/(.)\1+/g,'$1');
}

/* ইংরেজি শব্দ -> বাংলা সমার্থক (যেগুলো উচ্চারণে মেলে না) */
const SYN={rent:['ভাড়া'],house:['বাসা','বাড়ি'],home:['বাসা','বাড়ি'],price:['দাম','টাকা'],cost:['দাম','টাকা'],money:['টাকা'],sell:['বিক্রি'],sale:['বিক্রি'],sold:['বিক্রি'],buy:['কিনব','কেনা'],old:['পুরনো','পুরোনো'],used:['ব্যবহৃত','পুরনো'],book:['বই'],kitchen:['রান্নাঘর'],furniture:['ফার্নিচার','আসবাব']};

function match(q,hay){
  const toks=String(q||'').toLowerCase().trim().split(/\s+/).filter(Boolean);
  if(!toks.length)return true;
  const hl=String(hay||'').toLowerCase(),hk=key(hay);
  return toks.every(t=>{
    if(hl.includes(t))return true;
    const k=key(t);
    if(k.length>=2&&hk.includes(k))return true;
    return (SYN[t]||[]).some(a=>hl.includes(a.toLowerCase()));
  });
}

/* পুরনো সার্চ বক্সের জায়গায় নতুন বক্স বসায় (পুরনোটা লুকানো থাকে, যাতে বাকি কোড না ভাঙে) */
function swap(id){
  const o=$(id),n=o.cloneNode(false);
  n.id=id+'2';n.removeAttribute('oninput');n.value='';n.placeholder=PH;
  o.parentNode.insertBefore(n,o);o.style.display='none';o.value='';
  return n;
}

/* ---------- ১. মূল পেজ: বাসার বিজ্ঞাপন ---------- */
const s1=swap('searchInput');
s1.addEventListener('input',()=>applyFilters());
const _rl=renderListings;
renderListings=function(items){
  const q=s1.value.trim();
  _rl(q?items.filter(i=>match(q,[i.title,i.desc,i.area,i.address,i.type,i.specs,i.postedBy,i.available].join(' '))):items);
};
const _rf=resetFilters;
resetFilters=function(){s1.value='';_rf();};

/* ---------- ২. পুরনো জিনিস ও বাসা চাই পেজ ---------- */
function grid(inId,gridId,countId){
  const n=swap(inId),g=$(gridId),c=$(countId);
  const em=document.createElement('div');
  em.className='hidden text-center py-16 bg-white rounded-2xl border border-slate-100';
  em.innerHTML='<i class="fa-regular fa-face-frown text-4xl text-slate-400 mb-3 block"></i><h3 class="text-lg font-bold text-slate-800">কিছু পাওয়া যায়নি</h3><p class="text-sm text-slate-500">অন্য বানানে বা অন্য শব্দে চেষ্টা করুন।</p>';
  g.after(em);
  const hay=card=>{
    const a=card.firstElementChild?card.firstElementChild.textContent:'';
    const f=card.children[1],sp=f?f.querySelectorAll('span'):[];
    return a+' '+(sp[1]?sp[1].textContent:'');
  };
  function run(){
    const q=n.value.trim();let shown=0,real=0;
    [...g.children].forEach(card=>{
      if(card.classList.contains('col-span-full'))return;
      real++;
      const ok=!q||match(q,hay(card));
      card.style.display=ok?'':'none';
      if(ok)shown++;
    });
    if(real)c.textContent=shown;
    em.classList.toggle('hidden',!(q&&real&&!shown));
  }
  new MutationObserver(run).observe(g,{childList:true});
  n.addEventListener('input',run);
  return {n,run};
}
const mkS=grid('um_mkSearch','um_mkGrid','um_mkCount');
const rqS=grid('um_rqSearch','um_rqGrid','um_rqCount');
const _um=window.umResetMk;window.umResetMk=function(){mkS.n.value='';_um();mkS.run();};
const _ur=window.umResetRq;window.umResetRq=function(){rqS.n.value='';_ur();rqS.run();};

applyFilters();
})();
</script>
