/* ---------- helpers ---------- */
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
function safeUrl(u){u=String(u||'').trim();if(!/^https?:\/\//i.test(u))return '';return u.replace(/'/g,'%27').replace(/"/g,'%22').replace(/</g,'%3C').replace(/>/g,'%3E').replace(/\s/g,'%20');}
function normPhone(p){let d=String(p||'').replace(/\D/g,'');if(d.startsWith('880'))d=d.slice(2);else if(d.length===10&&d[0]==='1')d='0'+d;return d;}
function validPhone(p){return /^01[3-9]\d{8}$/.test(p);}
function cleanName(s){return String(s||'').replace(/[<>&"'`]/g,'').trim();}
function isAdmin(){return !!(currentUser&&currentUser.role==='admin');}
function canManage(item){return !!(currentUser&&(isAdmin()||item.ownerPhone===currentUser.phone));}
