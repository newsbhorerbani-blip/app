/* voice: cancel really cancels, mic is released, size/time limit */
async function toggleVoiceRecord(){
  if(!currentUser||!currentChatKey)return;
  if(mediaRecorder&&mediaRecorder.state==='recording'){stopAndSendVoiceRecord();return;}
  if(!navigator.mediaDevices||!window.MediaRecorder)return alert('আপনার ব্রাউজারে ভয়েস রেকর্ড সাপোর্ট করে না।');
  try{
    _voiceStream=await navigator.mediaDevices.getUserMedia({audio:true});
    const rec=new MediaRecorder(_voiceStream);mediaRecorder=rec;audioChunks=[];_voiceCancelled=false;
    const ctx={roomKey:currentChatKey,recipientPhone:activeChatRecipientPhone,listingId:activeChatListing?activeChatListing.id:'',listingTitle:activeChatListing?activeChatListing.title:''};
    rec.ondataavailable=e=>{if(e.data.size>0)audioChunks.push(e.data);};
    rec.onstop=()=>{
      _voiceStream.getTracks().forEach(t=>t.stop());
      clearInterval(recordingTimerInterval);clearTimeout(_voiceAutoStop);
      document.getElementById('recordingBanner').classList.add('hidden');
      if(_voiceCancelled||!audioChunks.length)return;
      const dur=formatSeconds(recordingSeconds);
      const blob=new Blob(audioChunks,{type:rec.mimeType||'audio/webm'});
      if(blob.size>700*1024)return alert('ভয়েস মেসেজটি অনেক বড়, ৩০ সেকেন্ডের মধ্যে রাখুন।');
      const r=new FileReader();
      r.onload=()=>postChatMessage(Object.assign({type:'voice',audioData:r.result,duration:dur},ctx)).catch(()=>alert('ভয়েস পাঠানো যায়নি।'));
      r.readAsDataURL(blob);
    };
    rec.start();recordingSeconds=0;
    document.getElementById('recordingBanner').classList.remove('hidden');
    document.getElementById('recordingTimer').textContent='00:00';
    recordingTimerInterval=setInterval(()=>{recordingSeconds++;document.getElementById('recordingTimer').textContent=formatSeconds(recordingSeconds);},1000);
    _voiceAutoStop=setTimeout(stopAndSendVoiceRecord,30000);
  }catch(err){alert('মাইক্রোফোনের অনুমতি দিন!');}
}
function stopAndSendVoiceRecord(){if(mediaRecorder&&mediaRecorder.state==='recording')mediaRecorder.stop();}
function cancelVoiceRecord(){if(mediaRecorder&&mediaRecorder.state==='recording'){_voiceCancelled=true;mediaRecorder.stop();}}

